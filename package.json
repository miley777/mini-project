{
  "name": "mini-project",
  "version": "1.0.0",
  "description": "This project was bootstrapped with Fastify-CLI.",
  "main": "app.js",
  
  "directories": {
    "test": "test"
  },
  "workspaces": ["my-app"],
  "scripts": {
    "test": "node --test test/**/*.test.js",
    "start": "fastify start -l info app.js",
    "dev": "fastify start -w -l info -P app.js",
    "build": "npm run build --prefix my-app"
  },
